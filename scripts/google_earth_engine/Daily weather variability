// CSV uploaded to Earth Engine Assets:
// outputs/epp_locations_for_gee_daily_weather.csv
//
// Required columns in the uploaded asset:
// epp_row_id, latitude, longitude, year, first_month

var epp = table;

var era5 = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
  .select(['temperature_2m', 'total_precipitation_sum']);

var points = epp.map(function(feature) {
  var lon = ee.Number.parse(feature.get('longitude'));
  var lat = ee.Number.parse(feature.get('latitude'));
  return feature.setGeometry(ee.Geometry.Point([lon, lat]));
});

function summarizeMonth(feature) {
  var year = ee.Number.parse(feature.get('year'));
  var month = ee.Number.parse(feature.get('first_month'));

  var start = ee.Date.fromYMD(year, month, 1);
  var end = start.advance(1, 'month');

  var daily = era5
    .filterDate(start, end)
    .map(function(image) {
      var tmeanC = image
        .select('temperature_2m')
        .subtract(273.15)
        .rename('tmean_C');

      var precipMm = image
        .select('total_precipitation_sum')
        .multiply(1000)
        .rename('precip_mm');

      return tmeanC
        .addBands(precipMm)
        .copyProperties(image, ['system:time_start']);
    });

  var tmpMean = daily
    .select('tmean_C')
    .mean()
    .rename('tmp_mean_C_first_month');

  var tmpSd = daily
    .select('tmean_C')
    .reduce(ee.Reducer.stdDev())
    .rename('tmp_sd_C_first_month');

  var tmpRange = daily
    .select('tmean_C')
    .max()
    .subtract(daily.select('tmean_C').min())
    .rename('tmp_range_C_first_month');

  var preSum = daily
    .select('precip_mm')
    .sum()
    .rename('pre_sum_mm_first_month');

  var preMean = daily
    .select('precip_mm')
    .mean()
    .rename('pre_mean_mm_day_first_month');

  var preSd = daily
    .select('precip_mm')
    .reduce(ee.Reducer.stdDev())
    .rename('pre_sd_mm_day_first_month');

  var preMax = daily
    .select('precip_mm')
    .max()
    .rename('pre_max_mm_day_first_month');

  var wetDays = daily
    .select('precip_mm')
    .map(function(image) {
      return image.gt(1).rename('wet_day');
    })
    .sum()
    .rename('pre_wet_days_gt1mm_first_month');

  var summaryImage = ee.Image.cat([
    tmpMean,
    tmpSd,
    tmpRange,
    preSum,
    preMean,
    preSd,
    preMax,
    wetDays
  ]);

  var values = summaryImage.reduceRegion({
    reducer: ee.Reducer.first(),
    geometry: feature.geometry(),
    scale: 11132,
    bestEffort: true
  });

  return feature
    .set(values)
    .set({
      weather_start_date: start.format('YYYY-MM-dd'),
      weather_end_date: end.advance(-1, 'day').format('YYYY-MM-dd'),
      weather_dataset: 'ECMWF/ERA5_LAND/DAILY_AGGR'
    });
}

var out = points.map(summarizeMonth);

print('Preview', out.limit(10));

Export.table.toDrive({
  collection: out,
  description: 'epp_era5_land_daily_variability_first_month',
  fileNamePrefix: 'epp_era5_land_daily_variability_first_month',
  fileFormat: 'CSV'
});
